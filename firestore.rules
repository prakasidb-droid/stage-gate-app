rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : 'unassigned';
    }

    function canReadProjects() {
      return role() in ['viewer', 'editor', 'admin'];
    }

    function canWriteProjects() {
      return role() in ['editor', 'admin'];
    }

    match /artifacts/{appId}/public/data/projects/{docId} {
      allow read: if canReadProjects();
      allow write: if canWriteProjects();
    }
  }
}
