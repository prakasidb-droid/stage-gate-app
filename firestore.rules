rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : 'unassigned';
    }

    function canReadProjects() {
      return role() in ['viewer', 'editor', 'admin'];
    }

    function canWriteProjects() {
      return role() in ['editor', 'admin'];
    }

    function isAllTeamsAdmin() {
      return role() == 'admin' && request.auth.token.allTeams == true;
    }

    function isTeamMember(teamId) {
      return signedIn() && request.auth.token.teamId == teamId;
    }

    match /teams/{teamId}/projects/{docId} {
      allow read: if isAllTeamsAdmin() || (isTeamMember(teamId) && canReadProjects());
      allow write: if isAllTeamsAdmin() || (isTeamMember(teamId) && canWriteProjects());
    }
  }
}
